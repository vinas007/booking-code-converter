# ─── Backend ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ─── Rate limiting & validation ─────────────────────────
RATE_LIMIT_PER_MINUTE=60
ADAPTER_TIMEOUT_MS=10000
MAX_CODE_LENGTH=500
MIN_CODE_LENGTH=3

# ─── Stake Sports Data API ────────────────────────────────
# Official API documented at https://docs-odds-data.stake.com/
# Obtain an API key through legitimate channels from Stake.
# Do not commit real keys.
STAKE_ODDS_API_KEY=
STAKE_ODDS_API_BASE_URL=https://odds-data.stake.com

# ─── Other bookmaker API keys (DO NOT commit real values) ─
# These are PLACEHOLDERS ONLY. We have not verified that any
# of these bookmakers provide a public developer API.

# SportyBet — official developer API status: UNVERIFIED
SPORTYBET_API_KEY=

# Other bookmakers — no investigation done yet
BET9JA_API_KEY=
BETKING_API_KEY=
BETANO_API_KEY=
BETBONANZA_API_KEY=
BETPAWA_API_KEY=
FOOTBALLCOM_API_KEY=
